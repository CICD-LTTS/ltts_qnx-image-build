# post_start.~20.graphics
# Start screen and the graphics stack

chown __SCREEN_ID__ /dev/io-hid/io-hid

echo '---> Starting DRM...'
drm-rpi5 -u __SCREEN_ID__:__SCREEN_ID__
waitfor /dev/dri/card0 15
if [ $? -ne 0 ]; then
    echo '---> waitfor /dev/dri/card0 failed.'
fi
waitfor /dev/dri/card1 15
if [ $? -ne 0 ]; then
    echo '---> waitfor /dev/dri/card1 failed.'
fi

# Detect how many displays are present.
# Screen needs to be configured with the correct number of displays
# as it won't always detect them properly.
_dispReport=$(drm-detect-displays | grep -E "^display .*, (connected|unknown)")
case "$_dispReport" in
    *"display 1"*)
        case "$_dispReport" in
            *"display 2"*)
                _screenCfg="graphics-rpi5-2xhdmi.conf"
                ;;
            *)
                _screenCfg="graphics-rpi5-hdmi1.conf"
                ;;
        esac
        ;;
    *"display 2"*)
        _screenCfg="graphics-rpi5-hdmi2.conf"
        ;;
    *)
        echo "WARNING: Unable to detect a display. Assuming one plugged into HDMI0"
        _screenCfg="graphics-rpi5-hdmi1.conf"
esac

echo '---> Starting Screen...'
time screen -u __SCREEN_ID__:__SCREEN_ID__ -c /usr/share/screen/${_screenCfg} >/dev/null 2>&1

time waitfor /dev/screen/ 15
if [ $? -ne 0 ]; then
    echo '---> waitfor /dev/screen failed.'
fi

echo '---> Dropping drm privileges'
echo drop_privileges > /dev/dri/qnxcommand
echo '---> Dropping screen privileges'
echo drop_privileges > /dev/screen/command
