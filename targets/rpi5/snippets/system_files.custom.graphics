bin/screeninfo=bin/screeninfo

# Config
lib/graphics/vulkan/VkLayer_khronos_validation.json=usr/lib/graphics/vulkan/VkLayer_khronos_validation.json

[type=link] lib/libscreen.so=libscreen.so.1
[type=link] lib/libscrmem.so=libscrmem.so.1
