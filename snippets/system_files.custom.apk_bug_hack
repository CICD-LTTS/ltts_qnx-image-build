
# add parallel toybox links that are currently in /proc/boot to /usr/bin to allow certain apk
# installations to work correctly
toybox=usr/bin/toybox
[type=link] bin/cat=toybox
[type=link] bin/chmod=toybox
[type=link] bin/dd=toybox
[type=link] bin/echo=toybox
[type=link] bin/ls=toybox
[type=link] bin/rm=toybox
[type=link] bin/ln=toybox

