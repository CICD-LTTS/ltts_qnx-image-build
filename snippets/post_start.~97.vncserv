# post_start.~97.vncserv
# Start the vncserv process to enable VNC connections
#   - Server will be available once the device has an IP address.
#   - The device IP address will also be the server address.

# setup default passwd file if not already setup.
if [ ! -f /etc/passwd.vncserv ]; then
    echo "Generating VNC server password file"
    vncserv -password=qnxuser
fi

vncserv -display=1 -auth
